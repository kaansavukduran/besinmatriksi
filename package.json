{
  "name": "besin-matriksi",
  "private": true,
  "version": "1.1.2-beta.16",
  "description": "Çevrimdışı, özelleştirilebilir bitkisel besin matriksi ve tarif hesaplayıcı",
  "type": "module",
  "scripts": {
    "data": "node scripts/build-data.mjs && node scripts/build-efsa.mjs",
    "dev": "vite",
    "build": "npm run notices && vite build && node scripts/postbuild.mjs",
    "build:single": "npm run notices && vite build --mode single && node scripts/postbuild.mjs --single",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "tauri": "tauri",
    "cap": "cap",
    "test:browser": "playwright test",
    "notices": "node scripts/build-notices.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@fontsource/andika": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/noto-sans-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0"
  },
  "license": "MIT"
}
