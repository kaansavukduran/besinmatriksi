{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Besin Matriksi",
  "version": "1.1.2-beta.19",
  "identifier": "io.github.kaansavukduran.besinmatriksi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Besin Matriksi",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Çevrimdışı bitkisel besin matriksi",
    "longDescription": "Bitkisel besinlerin ayrıntılı bileşimi, tarif toplamları ve karşılaştırma; tamamen çevrimdışı.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "version": "1.1.2"
      }
    }
  }
}
